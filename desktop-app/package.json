{
  "name": "umamusume-skill-emulator-desktop",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run sync-version && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "stitch:golden": "vitest run app/lib/stitch/golden.test.ts",
    "sync-version": "node scripts/sync-cargo-version.js",
    "tauri": "npm run sync-version && tauri",
    "extract-skill-info": "node ../tools/mdb-extractor/extract_rarity_from_mdb.js",
    "extract-umasim-skills": "node ../tools/mdb-extractor/extract_umasim_skill_data.js",
    "build:release-exe": "powershell -ExecutionPolicy Bypass -File scripts/build-release-exe.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-window-state": "^2.2.0",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-select": "^5.10.2",
    "recharts": "^3.8.1",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/string-similarity": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
